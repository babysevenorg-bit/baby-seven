// Prisma schema for Baby Seven cinematic personal brand app (v2.0).
// Uses SQLite (per environment constraint).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Incoming collaboration requests submitted via the Collaboration Portal.
model Collaboration {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  tier      String   // 'Apprentice' | 'Partner' | 'Exec'
  budget    Int      // integer budget in USD
  message   String
  status    String   @default("Pending") // 'Pending' | 'Reviewed' | 'Hired'
  createdAt DateTime @default(now())
}

/// Reel editor applicants (Reel Editors & Makers collaboration hub).
model ReelEditor {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  portfolioLink  String
  editingStyle   String   // 'Fast-Paced' | 'Cinematic' | 'Story-driven' | 'Viral/Hook'
  sampleReelUrl  String?
  status         String   @default("Pending") // 'Pending' | 'Shortlisted' | 'Hired'
  createdAt      DateTime @default(now())
}

/// Portfolio projects (writing, video, scripts).
model Project {
  id          String  @id @default(cuid())
  title       String
  category    String  // 'Writing' | 'Video' | 'Script'
  description String
  coverImage  String  // URL or path
  videoUrl    String? // optional video embed/link
  isFeatured  Boolean @default(false)
  rank        Int?    // optional search-rank highlight (e.g. 1 for Blood Disaster)
}

/// Client testimonials.
model Testimonial {
  id          String @id @default(cuid())
  clientName  String
  text        String
  rating      Int    // 1..5
  projectType String? // e.g. 'Writing' | 'Video' | 'Script'
}

/// Per-route popularity counter.
model PageView {
  id    String @id @default(cuid())
  route String
  count Int    @default(0)
}

/// "Notify Me" subscribers who want a launch alert when the Support Hub
/// goes live (collected while the Support page is in Maintenance Mode).
model NotifySubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  notified  Boolean  @default(false) // set true once the launch email is sent
}

/// Admin users for the protected Studio admin panel.
/// Passwords are hashed with bcrypt (12 rounds) — never stored in plaintext.
/// Created by `scripts/create-admin.ts` (interactive, run on your machine).
model AdminUser {
  id              String   @id @default(cuid())
  username        String   @unique
  passwordHash    String   // bcrypt hash, never the plaintext password
  role            String   @default("admin") // 'admin' | 'owner'
  createdAt       DateTime @default(now())
  lastLoginAt     DateTime?
  failedAttempts  Int      @default(0)  // resets to 0 on successful login
  lockedUntil     DateTime? // set when failedAttempts >= 5; clears after 15min
}

/// Active admin sessions (server-side session store).
/// Each login creates a row; each logout deletes it. Sessions also expire
/// after 24 hours of inactivity (enforced by the verifier).
model AdminSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // SHA-256 of the cookie token — never store the raw token
  createdAt DateTime @default(now())
  expiresAt DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?
  ip         String?
}
