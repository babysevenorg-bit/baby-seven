// Prisma schema for Baby Seven cinematic personal brand app (v2.0).
// Uses SQLite (per environment constraint).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Incoming collaboration requests submitted via the Collaboration Portal.
model Collaboration {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  tier      String   // 'Apprentice' | 'Partner' | 'Exec'
  budget    Int      // integer budget in USD
  message   String
  status    String   @default("Pending") // 'Pending' | 'Reviewed' | 'Hired'
  createdAt DateTime @default(now())
}

/// Reel editor applicants (Reel Editors & Makers collaboration hub).
model ReelEditor {
  id             String   @id @default(cuid())
  fullName       String
  email          String
  portfolioLink  String
  editingStyle   String   // 'Fast-Paced' | 'Cinematic' | 'Story-driven' | 'Viral/Hook'
  sampleReelUrl  String?
  status         String   @default("Pending") // 'Pending' | 'Shortlisted' | 'Hired'
  createdAt      DateTime @default(now())
}

/// Portfolio projects (writing, video, scripts).
model Project {
  id          String  @id @default(cuid())
  title       String
  category    String  // 'Writing' | 'Video' | 'Script'
  description String
  coverImage  String  // URL or path
  videoUrl    String? // optional video embed/link
  isFeatured  Boolean @default(false)
  rank        Int?    // optional search-rank highlight (e.g. 1 for Blood Disaster)
}

/// Client testimonials.
model Testimonial {
  id          String @id @default(cuid())
  clientName  String
  text        String
  rating      Int    // 1..5
  projectType String? // e.g. 'Writing' | 'Video' | 'Script'
}

/// Per-route popularity counter.
model PageView {
  id    String @id @default(cuid())
  route String
  count Int    @default(0)
}
