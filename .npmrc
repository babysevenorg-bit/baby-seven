# .npmrc — npm configuration for the Baby Seven repo.
#
# Why this exists:
#   @cloudflare/next-on-pages@1.13.15 (a devDependency) declares
#   @cloudflare/workers-types@^4.x as a peerOptional.
#   wrangler@4.130.0 (pulled in by next-on-pages) declares
#   @cloudflare/workers-types@^5.x as a peerOptional.
#   npm v7+ tries to resolve a single version that satisfies both peer
#   ranges, fails, and aborts with ERESOLVE.
#
# legacy-peer-deps=true tells npm to use the npm v6 peer-resolution behavior
# (peer deps are warnings, not hard constraints). Both peer ranges are
# marked peerOptional, so neither is actually required — npm simply installs
# next-on-pages and wrangler without trying to satisfy either peer range.
# This is the same approach the Next.js repo uses internally.
#
# Verified safe: the build pipeline (bun run pages:build → @cloudflare/next-on-pages)
# works correctly with this config.
legacy-peer-deps=true
